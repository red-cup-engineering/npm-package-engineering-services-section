{
  "name": "@red-cup-engineering/npm-package-manifest-path-selection-service",
  "version": "0.2.2",
  "description": "Selects package.json paths from an explicit ordered path collection.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/select-npm-package-manifest-paths.mjs",
  "bin": {
    "select-npm-package-manifest-paths": "scripts/select-npm-package-manifest-paths.mjs"
  },
  "files": [
    "scripts",
    "package.json",
    "data/records/schema"
  ],
  "dependencies": {
    "@red-cup-engineering/computer-data-engine": "0.10.0",
    "@red-cup-engineering/javascript-node-services-section": "0.2.0",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.2.1",
    "@red-cup-engineering/write-javascript-node-standard-output-text-service": "0.2.1"
  },
  "scripts": {
    "check": "node --check scripts/select-npm-package-manifest-paths.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24"
  }
}
